---
import "../styles/globals.css";
import TrackingBody from "@/components/TrackingBody.astro";
import TrackingHead from "@/components/TrackingHead.astro";
import { ORNIS_FREE_PROMO_CODE, ORNIS_FREE_PROMO_TOTAL, ORNIS_PROMO_CODES, formatRM, getAppliedPromoCode, getPayableTotal, getUnitPrice, parseCheckoutItems } from "@/lib/ornis/catalog";

export const prerender = false;

const items = parseCheckoutItems(Astro.url.searchParams);
const promoCode = getAppliedPromoCode(Astro.url.searchParams.get("promo"));
const subtotal = getPayableTotal(items, promoCode);
const originalSubtotal = items.reduce((sum, item) => sum + item.originalPrice * item.quantity, 0);
const cancelled = Astro.url.searchParams.get("cancelled") === "1";
const catalogForScript = JSON.stringify(
  items.map((item) => ({
    id: item.id,
    name: `${item.model} ${item.color}`,
    originalPrice: item.originalPrice,
    discountedPrice: item.discountedPrice,
    dealerDiscountedPrice: item.dealerDiscountedPrice,
  })),
).replace(/</g, "\\u003c");
const checkoutEvent = {
  currency: "MYR",
  value: subtotal,
  contentIds: items.map((item) => item.id),
  contents: items.map((item) => ({
    id: item.id,
    quantity: item.quantity,
    item_price: getUnitPrice(item, promoCode),
  })),
  numItems: items.reduce((sum, item) => sum + item.quantity, 0),
  items: items.map((item) => ({
    item_id: item.id,
    item_name: `${item.model} ${item.color}`,
    item_variant: item.color,
    price: getUnitPrice(item, promoCode),
    quantity: item.quantity,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Complete your Ornis order securely with Fiuu hosted payment." />
    <TrackingHead />
    <script is:inline define:vars={{ checkoutEvent }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ ecommerce: null });
      window.dataLayer.push({
        event: "begin_checkout",
        currency: checkoutEvent.currency,
        value: checkoutEvent.value,
        ecommerce: checkoutEvent,
      });
      window.ornisTrackMetaEvent?.("InitiateCheckout", {
        content_ids: checkoutEvent.contentIds,
        contents: checkoutEvent.contents,
        content_type: "product",
        currency: checkoutEvent.currency,
        value: checkoutEvent.value,
        num_items: checkoutEvent.numItems,
      });
      window.ornisTrack?.("begin_checkout", checkoutEvent);
      window.posthog?.capture('checkout_started', {
        currency: checkoutEvent.currency,
        value: checkoutEvent.value,
        num_items: checkoutEvent.numItems,
        item_ids: checkoutEvent.contentIds,
      });
    </script>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230f565d'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23f6f1ea'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23f6f1ea' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Ornis Checkout</title>
  </head>
  <body class="checkout-body">
    <TrackingBody />
    <main class="checkout-shell">
      <header class="checkout-header">
        <a class="checkout-logo" href="/" aria-label="Back to Falcon Safe home">
          <img
            src="/ornis/falcon-safe-footer-logo.png"
            alt="Falcon Safe - The World's Trusted Safe"
            width="225"
            height="225"
            loading="eager"
            decoding="async"
          />
        </a>
        <span>Secure checkout via Fiuu</span>
      </header>

      {cancelled && (
        <div class="checkout-alert" role="status">
          Payment was cancelled. You can review the order and try again.
        </div>
      )}

      <form class="checkout-layout" action="/api/checkout" method="post" data-checkout-form>
        <input type="hidden" name="checkoutDraftId" data-prepayment-field="draftId" />
        <input type="hidden" name="checkoutFirstSeenAt" data-prepayment-field="firstSeenAt" />
        <input type="hidden" name="checkoutFullUrl" data-prepayment-field="fullUrl" />
        <input type="hidden" name="checkoutReferrer" data-prepayment-field="referrer" />
        <input type="hidden" name="checkoutUserAgent" data-prepayment-field="userAgent" />
        <input type="hidden" name="checkoutClid" data-prepayment-field="clid" />
        <input type="hidden" name="checkoutFbclid" data-prepayment-field="fbclid" />
        <input type="hidden" name="checkoutTtclid" data-prepayment-field="ttclid" />
        <input type="hidden" name="checkoutGclid" data-prepayment-field="gclid" />
        <input type="hidden" name="checkoutUtmSource" data-prepayment-field="utm_source" />
        <input type="hidden" name="checkoutUtmMedium" data-prepayment-field="utm_medium" />
        <input type="hidden" name="checkoutUtmCampaign" data-prepayment-field="utm_campaign" />
        <section class="checkout-main" aria-labelledby="checkout-title">
          <div class="checkout-title">
            <p>Free delivery included</p>
            <h1 id="checkout-title">Complete Your Ornis Order</h1>
          </div>

          <fieldset class="checkout-section">
            <legend>Customer Details</legend>
            <div class="checkout-grid">
              <label>
                <span>Name</span>
                <input name="name" autocomplete="name" required />
              </label>
              <label>
                <span>Phone</span>
                <input name="phone" autocomplete="tel" required />
              </label>
              <label>
                <span>Email</span>
                <input name="email" type="email" autocomplete="email" required />
              </label>
              <label>
                <span>Postcode</span>
                <input name="postcode" autocomplete="postal-code" required />
              </label>
              <label class="checkout-grid__full">
                <span>Address</span>
                <textarea name="address" rows="3" autocomplete="street-address" required></textarea>
              </label>
              <label>
                <span>State</span>
                <select name="state" required>
                  <option value="">Select state</option>
                  <option>Johor</option>
                  <option>Kedah</option>
                  <option>Kelantan</option>
                  <option>Kuala Lumpur</option>
                  <option>Labuan</option>
                  <option>Melaka</option>
                  <option>Negeri Sembilan</option>
                  <option>Pahang</option>
                  <option>Penang</option>
                  <option>Perak</option>
                  <option>Perlis</option>
                  <option>Putrajaya</option>
                  <option>Selangor</option>
                  <option>Terengganu</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset class="checkout-section">
            <legend>Voucher</legend>
            <label class="voucher-field">
              <span>Discount code</span>
              <input id="promo-code" name="promoCode" value={promoCode} autocomplete="off" />
            </label>
          </fieldset>
        </section>

        <aside class="checkout-summary" aria-label="Order summary">
          <h2>Order Summary</h2>

          <div class="summary-items">
            {
              items.map((item) => (
                <article
                  class="summary-item"
                  data-line-item
                  data-item-id={item.id}
                  data-original-price={item.originalPrice}
                  data-discounted-price={item.discountedPrice}
                  data-dealer-discounted-price={item.dealerDiscountedPrice}
                >
                  <input type="hidden" name="itemId" value={item.id} />
                  <img src={item.image} alt={`${item.model} ${item.color} safe`} width="320" height="240" />
                  <div>
                    <h3>{item.model} {item.color}</h3>
                    <p>{item.specs}</p>
                    <div class="quantity-row">
                      <label>
                        <span>Quantity</span>
                        <input
                          name="quantity"
                          type="number"
                          inputmode="numeric"
                          min="1"
                          value={item.quantity}
                          data-quantity
                          required
                        />
                      </label>
                      <strong data-line-total>{formatRM(getUnitPrice(item, promoCode) * item.quantity)}</strong>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>

          <section class="checkout-assurance" aria-label="Ornis purchase assurance">
            <div>
              <span>Lowest price possible</span>
            </div>
            <div>
              <span>Direct from manufacturer</span>
            </div>
            <div>
              <span>3 days delivery guarantee</span>
            </div>
          </section>

          <dl class="summary-totals">
            <div>
              <dt>Original subtotal</dt>
              <dd data-original-subtotal>{formatRM(originalSubtotal)}</dd>
            </div>
            <div>
              <dt>Discount</dt>
              <dd data-discount>{formatRM(originalSubtotal - subtotal)}</dd>
            </div>
            <div>
              <dt>Shipping</dt>
              <dd>Free</dd>
            </div>
            <div class="summary-totals__total">
              <dt>Total</dt>
              <dd data-total>{formatRM(subtotal)}</dd>
            </div>
          </dl>

          <button class="checkout-button" type="submit">Pay Securely</button>
          <p class="checkout-note">You will be redirected to Fiuu's hosted payment page to choose FPX, card, e-wallet, DuitNow QR, or any enabled channel.</p>
          <section class="checkout-trust" aria-label="Checkout credibility logos">
            <p>Secured by</p>
            <div class="checkout-trust__logos">
              <img
                src="/ornis/trust-ssm.png"
                alt="Suruhanjaya Syarikat Malaysia logo"
                width="552"
                height="231"
                loading="lazy"
                decoding="async"
              />
              <img
                src="/ornis/trust-mcmc.png"
                alt="Malaysian Communications and Multimedia Commission logo"
                width="343"
                height="288"
                loading="lazy"
                decoding="async"
              />
              <img
                src="/ornis/trust-fiuu.png"
                alt="Fiuu logo"
                width="271"
                height="251"
                loading="lazy"
                decoding="async"
              />
            </div>
          </section>
        </aside>
      </form>
    </main>

    <script is:inline define:vars={{ catalogForScript, promoCodes: ORNIS_PROMO_CODES, freePromoCode: ORNIS_FREE_PROMO_CODE, freePromoTotal: ORNIS_FREE_PROMO_TOTAL }}>
      const catalog = JSON.parse(catalogForScript);
      const formatter = new Intl.NumberFormat("en-MY", {
        style: "currency",
        currency: "MYR",
        maximumFractionDigits: 0,
      });
      const formatRM = (value) => formatter.format(value).replace("MYR", "RM");
      const promoInput = document.querySelector("#promo-code");
      const lineItems = Array.from(document.querySelectorAll("[data-line-item]"));
      const originalSubtotal = document.querySelector("[data-original-subtotal]");
      const discount = document.querySelector("[data-discount]");
      const total = document.querySelector("[data-total]");
      const checkoutForm = document.querySelector("[data-checkout-form]");
      const prePaymentFields = {
        draftId: document.querySelector('[data-prepayment-field="draftId"]'),
        firstSeenAt: document.querySelector('[data-prepayment-field="firstSeenAt"]'),
        fullUrl: document.querySelector('[data-prepayment-field="fullUrl"]'),
        referrer: document.querySelector('[data-prepayment-field="referrer"]'),
        userAgent: document.querySelector('[data-prepayment-field="userAgent"]'),
        clid: document.querySelector('[data-prepayment-field="clid"]'),
        fbclid: document.querySelector('[data-prepayment-field="fbclid"]'),
        ttclid: document.querySelector('[data-prepayment-field="ttclid"]'),
        gclid: document.querySelector('[data-prepayment-field="gclid"]'),
        utm_source: document.querySelector('[data-prepayment-field="utm_source"]'),
        utm_medium: document.querySelector('[data-prepayment-field="utm_medium"]'),
        utm_campaign: document.querySelector('[data-prepayment-field="utm_campaign"]'),
      };
      let lastAppliedPromoCode = "";
      let lastPrePaymentPayload = "";
      let prePaymentTimer;
      let checkoutSubmitInProgress = false;

      const getStorageId = (key, prefix) => {
        try {
          let value = window.sessionStorage.getItem(key);
          if (!value) {
            value = `${prefix}_${crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36)}`;
            window.sessionStorage.setItem(key, value);
          }
          return value;
        } catch {
          return `${prefix}_${Date.now().toString(36)}`;
        }
      };

      const getStorageTimestamp = (key) => {
        try {
          let value = window.sessionStorage.getItem(key);
          if (!value) {
            value = new Date().toISOString();
            window.sessionStorage.setItem(key, value);
          }
          return value;
        } catch {
          return new Date().toISOString();
        }
      };

      const checkoutDraftId = getStorageId("ornis_checkout_draft_id", "checkout");
      const checkoutFirstSeenAt = getStorageTimestamp("ornis_checkout_first_seen_at");

      const updatePrePaymentHiddenFields = () => {
        const attribution = window.ornisGetAttribution?.() || {};
        const values = {
          draftId: checkoutDraftId,
          firstSeenAt: checkoutFirstSeenAt,
          fullUrl: window.location.href,
          referrer: document.referrer || "",
          userAgent: navigator.userAgent || "",
          clid: attribution.clid || "",
          fbclid: attribution.fbclid || "",
          ttclid: attribution.ttclid || "",
          gclid: attribution.gclid || "",
          utm_source: attribution.utm_source || "",
          utm_medium: attribution.utm_medium || "",
          utm_campaign: attribution.utm_campaign || "",
        };

        Object.entries(values).forEach(([key, value]) => {
          if (prePaymentFields[key]) prePaymentFields[key].value = value;
        });
      };

      const getAppliedPromoCode = () => {
        const normalized = promoInput?.value.trim().toUpperCase() ?? "";
        return promoCodes.includes(normalized) ? normalized : "";
      };

      const getUnitPrice = (item, appliedPromoCode) => {
        if (appliedPromoCode === freePromoCode) return 0;
        if (appliedPromoCode === "FALCON45") return item.dealerDiscountedPrice;
        if (appliedPromoCode) return item.discountedPrice;
        return item.originalPrice;
      };

      const getPayableTotal = (subtotal, appliedPromoCode) =>
        appliedPromoCode === freePromoCode ? freePromoTotal : subtotal;

      const getCurrentCheckoutEvent = () => {
        const appliedPromoCode = getAppliedPromoCode();
        const contents = [];
        const items = [];
        let value = 0;
        let numItems = 0;

        lineItems.forEach((line) => {
          const item = catalog.find((entry) => entry.id === line.dataset.itemId);
          const quantityInput = line.querySelector("[data-quantity]");
          const quantity = Math.max(Number(quantityInput?.value) || 1, 1);
          const price = getUnitPrice(item, appliedPromoCode);

          contents.push({ id: item.id, quantity, item_price: price });
          items.push({ item_id: item.id, name: item.name, price, quantity });
          value += price * quantity;
          numItems += quantity;
        });
        value = getPayableTotal(value, appliedPromoCode);

        return {
          content_ids: contents.map((item) => item.id),
          contents,
          content_type: "product",
          currency: "MYR",
          value,
          num_items: numItems,
          items,
          coupon: appliedPromoCode,
        };
      };

      const getFieldValue = (name) => checkoutForm?.elements?.[name]?.value?.trim?.() || "";

      const getPrePaymentPayload = (status = "Draft") => {
        updatePrePaymentHiddenFields();
        const checkoutPayload = getCurrentCheckoutEvent();

        return {
          draftId: checkoutDraftId,
          status,
          firstSeenAt: checkoutFirstSeenAt,
          submittedAt: status === "Submitted to Fiuu" ? new Date().toISOString() : "",
          customer: {
            name: getFieldValue("name"),
            phone: getFieldValue("phone"),
            email: getFieldValue("email"),
            address: getFieldValue("address"),
            postcode: getFieldValue("postcode"),
            state: getFieldValue("state"),
          },
          items: checkoutPayload.items.map((item) => ({
            id: item.item_id,
            name: item.name || item.item_id,
            quantity: item.quantity,
            price: item.price,
          })),
          quantity: checkoutPayload.num_items,
          promoCode: checkoutPayload.coupon,
          checkoutValue: checkoutPayload.value,
          attribution: {
            clid: prePaymentFields.clid?.value || "",
            fbclid: prePaymentFields.fbclid?.value || "",
            ttclid: prePaymentFields.ttclid?.value || "",
            gclid: prePaymentFields.gclid?.value || "",
            utm_source: prePaymentFields.utm_source?.value || "",
            utm_medium: prePaymentFields.utm_medium?.value || "",
            utm_campaign: prePaymentFields.utm_campaign?.value || "",
          },
          fullUrl: window.location.href,
          referrer: document.referrer || "",
          userAgent: navigator.userAgent || "",
        };
      };

      const hasPrePaymentContact = (payload) =>
        Boolean(payload.customer.name || payload.customer.phone || payload.customer.email);

      const savePrePaymentPayload = async (status = "Draft", force = false) => {
        const payload = getPrePaymentPayload(status);
        if (!hasPrePaymentContact(payload)) return;

        const payloadText = JSON.stringify(payload);
        if (!force && payloadText === lastPrePaymentPayload) return;
        lastPrePaymentPayload = payloadText;

        try {
          await fetch("/api/pre-payment-info", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: payloadText,
            keepalive: true,
          });
        } catch (error) {
          console.error("Unable to save pre-payment info.", error);
        }
      };

      const schedulePrePaymentSave = () => {
        window.clearTimeout(prePaymentTimer);
        prePaymentTimer = window.setTimeout(() => savePrePaymentPayload("Draft"), 1500);
      };

      const updateSummary = () => {
        const appliedPromoCode = getAppliedPromoCode();
        let original = 0;
        let payableSubtotal = 0;

        lineItems.forEach((line) => {
          const item = catalog.find((entry) => entry.id === line.dataset.itemId);
          const quantityInput = line.querySelector("[data-quantity]");
          const lineTotal = line.querySelector("[data-line-total]");
          const quantity = Math.max(Number(quantityInput?.value) || 1, 1);

          if (quantityInput && String(quantityInput.value) !== String(quantity)) {
            quantityInput.value = String(quantity);
          }

          original += item.originalPrice * quantity;
          payableSubtotal += getUnitPrice(item, appliedPromoCode) * quantity;

          if (lineTotal) {
            lineTotal.textContent = formatRM(getUnitPrice(item, appliedPromoCode) * quantity);
          }
        });

        const payable = getPayableTotal(payableSubtotal, appliedPromoCode);

        if (originalSubtotal) originalSubtotal.textContent = formatRM(original);
        if (discount) discount.textContent = formatRM(original - payable);
        if (total) total.textContent = formatRM(payable);
      };

      promoInput?.addEventListener("input", updateSummary);
      checkoutForm?.addEventListener("input", schedulePrePaymentSave);
      checkoutForm?.addEventListener("change", schedulePrePaymentSave);
      lineItems.forEach((line) => {
        line.querySelector("[data-quantity]")?.addEventListener("input", () => {
          updateSummary();
          const checkoutPayload = getCurrentCheckoutEvent();
          window.ornisTrackMetaCustomEvent?.("CartQuantityUpdate", {
            content_ids: checkoutPayload.content_ids,
            contents: checkoutPayload.contents,
            content_type: "product",
            currency: checkoutPayload.currency,
            value: checkoutPayload.value,
            num_items: checkoutPayload.num_items,
          });
          window.ornisTrack?.("cart_quantity_update", checkoutPayload);
        });
      });
      promoInput?.addEventListener("input", () => {
        const appliedPromoCode = getAppliedPromoCode();
        if (appliedPromoCode && appliedPromoCode !== lastAppliedPromoCode) {
          lastAppliedPromoCode = appliedPromoCode;
          const checkoutPayload = getCurrentCheckoutEvent();
          window.ornisTrackMetaCustomEvent?.("VoucherApply", {
            content_name: "Ornis checkout voucher",
            coupon: appliedPromoCode,
            currency: checkoutPayload.currency,
            value: checkoutPayload.value,
          });
          window.ornisTrack?.("voucher_apply", {
            content_name: "Ornis checkout voucher",
            ...checkoutPayload,
          });
          window.posthog?.capture('voucher_applied', {
            coupon: appliedPromoCode,
            currency: checkoutPayload.currency,
            value: checkoutPayload.value,
          });
        }
        if (!appliedPromoCode) lastAppliedPromoCode = "";
      });
      checkoutForm?.addEventListener("submit", async (event) => {
        if (checkoutSubmitInProgress) return;
        event.preventDefault();
        checkoutSubmitInProgress = true;
        window.clearTimeout(prePaymentTimer);

        const checkoutPayload = getCurrentCheckoutEvent();
        window.ornisTrackMetaEvent?.("AddPaymentInfo", {
          content_ids: checkoutPayload.content_ids,
          contents: checkoutPayload.contents,
          content_type: "product",
          currency: checkoutPayload.currency,
          value: checkoutPayload.value,
          num_items: checkoutPayload.num_items,
        });
        window.ornisTrack?.("add_payment_info", checkoutPayload);
        window.posthog?.capture('payment_info_submitted', {
          currency: checkoutPayload.currency,
          value: checkoutPayload.value,
          num_items: checkoutPayload.num_items,
          coupon: checkoutPayload.coupon || undefined,
        });
        await savePrePaymentPayload("Submitted to Fiuu", true);
        checkoutForm.submit();
      });
      updatePrePaymentHiddenFields();
      updateSummary();
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  .checkout-body {
    min-width: 320px;
    margin: 0;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.66), transparent 26rem),
      #f6f1ea;
    color: #1f2020;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .checkout-shell {
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .checkout-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    color: #665d57;
  }

  .checkout-logo {
    display: inline-flex;
    align-items: center;
    width: clamp(5.5rem, 14vw, 7.5rem);
    text-decoration: none;
  }

  .checkout-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .checkout-alert {
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(149, 95, 105, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.76);
    color: #955f69;
    font-weight: 500;
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 28rem);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .checkout-main,
  .checkout-summary {
    border: 1px solid rgba(14, 89, 99, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 1rem 2.5rem rgba(52, 40, 31, 0.08);
  }

  .checkout-main {
    display: grid;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .checkout-title p {
    margin: 0 0 0.4rem;
    color: #955f69;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .checkout-title h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1;
  }

  .checkout-section {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .checkout-section legend,
  .checkout-summary h2 {
    margin: 0;
    color: #0e5963;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .checkout-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .checkout-grid__full {
    grid-column: 1 / -1;
  }

  label {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
    color: #665d57;
    font-size: 0.9rem;
    font-weight: 500;
  }

  input,
  textarea,
  select {
    width: 100%;
    min-height: 3rem;
