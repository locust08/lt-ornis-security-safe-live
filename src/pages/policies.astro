---
import "../styles/globals.css";
import TrackingBody from "@/components/TrackingBody.astro";
import TrackingHead from "@/components/TrackingHead.astro";

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Falcon Safe privacy policy, return and refund policy, and terms and conditions."
    />
    <TrackingHead />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111111'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23ffe330'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23ffe330' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Falcon Safe Policies</title>
  </head>
  <body class="policies-page">
    <TrackingBody />
    <header class="policies-hero">
      <a class="policies-logo" href="/" aria-label="Falcon Safe home">
        <img
          src="/ornis/falcon-safe-footer-logo.png"
          alt="Falcon Safe - The World's Trusted Safe"
          width="225"
          height="225"
          loading="eager"
          decoding="async"
        />
      </a>
      <p>Falcon Safe Legal Policies</p>
      <h1>Privacy, Returns, and Terms</h1>
      <span>Updated from the shared policy document.</span>
    </header>

    <main class="policies-shell">
      <nav class="policies-tabs" aria-label="Policy sections" role="tablist">
        <a id="privacy" href="#privacy" role="tab" aria-controls="privacy-panel" aria-selected="true" data-policy-tab="privacy">
          Privacy Policy
        </a>
        <a id="returns" href="#returns" role="tab" aria-controls="returns-panel" aria-selected="false" data-policy-tab="returns">
          Return & Refund
        </a>
        <a id="terms" href="#terms" role="tab" aria-controls="terms-panel" aria-selected="false" data-policy-tab="terms">
          Terms & Conditions
        </a>
      </nav>

      <section class="policy-panel is-active" id="privacy-panel" aria-labelledby="privacy" data-policy-panel="privacy">
        <p class="policy-eyebrow">Privacy Policy</p>
        <h2>How Falcon Safe protects your data</h2>
        <div class="policy-copy">
          <p>
            Falcon Safe Malaysia Sdn Bhd treats customer privacy as important and respects and guards customers'
            rights. We only collect information from you to ensure your orders are placed successfully on this
            website.
          </p>
          <p>
            Appropriate measures are in place to keep your personal information confidential and we do not share or
            pass on information except where it may be necessary to do so to ensure your order can be fulfilled. We
            guarantee that our customer database will not be sold or marketed for any reason whatsoever to third
            parties.
          </p>
          <p>
            Falcon Safe Malaysia Sdn Bhd website may contain links to websites operated by third parties and these
            websites should contain their own privacy policies. Thus, Falcon Safe Malaysia Sdn Bhd makes no guarantees
            in respect to how your information may be used in these third party websites.
          </p>
          <p>
            Falcon Safe Malaysia Sdn Bhd is the owner of information that is submitted and by submitting any of your
            information you are consenting to the storage and where applicable retrieval of your information so
            submitted for the purposes set out herein.
          </p>
          <p>
            Falcon Safe Malaysia Sdn Bhd reserves the right to modify or remove portions of this privacy policy at any
            time and this Privacy Policy should be read with the other terms and conditions applicable to the use of
            this website. Any condition that is not enforceable, void or invalid shall be deemed severable here from and
            all other conditions remaining shall be enforceable and valid.
          </p>
          <p>If you have any questions regarding this Privacy Policy or your dealings with our website, please contact our customer service:</p>
          <ul>
            <li>Contact Email: <a href="mailto:falcon@falconsafe.com">falcon@falconsafe.com</a></li>
            <li>Contact No.: <a href="tel:+601152583633">011-5258 3633</a></li>
            <li>
              Other Channels:
              <a href="https://www.facebook.com/share/1DsrR6o7wa/?mibextid=wwXIfr">Falcon Safe Facebook</a>
            </li>
          </ul>
        </div>
      </section>

      <section class="policy-panel" id="returns-panel" aria-labelledby="returns" data-policy-panel="returns" hidden>
        <p class="policy-eyebrow">Return & Refund Policy</p>
        <h2>Returns, refunds, and exchanges</h2>
        <div class="policy-copy">
          <p>
            At Falcon Safe Marketing Sdn Bhd, we value our customers and strive to ensure a satisfactory shopping
            experience. If you are not completely satisfied with your purchase, please refer to our return policy below.
          </p>

          <h3>Return Window</h3>
          <p>
            If you receive incorrect, missing, or damaged/defective items during delivery, you may be eligible for an
            exchange or refund within 7 days of receiving your item. After this period, we regret that we cannot offer
            a refund or exchange.
          </p>

          <h3>Refunds</h3>
          <p>Refunds are available under the following conditions:</p>
          <ul>
            <li>If you receive incorrect items that do not match your order.</li>
            <li>If your order is missing items.</li>
            <li>If the items received are damaged or defective upon arrival.</li>
          </ul>
          <p>
            To initiate a refund, please email us at <a href="mailto:falcon@falconsafe.com">falcon@falconsafe.com</a>
            with the subject line "REFUND". Your email must include your order number, reason for refund, and photo
            evidence of the defect, damage, incorrect item, or missing item where applicable. Our customer service
            representative will assist you with the refund process. Refunds will be processed in cash via bank transfer
            to the customer's designated bank account.
          </p>
          <p>
            All approved refunds will be processed via bank transfer within 7-14 working days upon verification and
            approval of the refund request.
          </p>

          <h3>Exchanges</h3>
          <p>Exchanges are available under the following conditions:</p>
          <ul>
            <li>If the items received are damaged during delivery.</li>
            <li>If the items received are defective.</li>
            <li>
              To be eligible for an exchange, your item must be unused, in the same condition as received, and in its
              original packaging. We require visual proof of the damage/defect from your initial inspection, along with
              your Returns slip.
            </li>
          </ul>
          <p>Please follow these steps to initiate an exchange:</p>
          <ol>
            <li>Email <a href="mailto:falcon@falconsafe.com">falcon@falconsafe.com</a> with the subject line "EXCHANGE".</li>
            <li>Provide photo evidence of the damage/defect.</li>
            <li>Return the damaged/incorrect items to Falcon Safe Marketing Sdn Bhd.</li>
            <li>Our customer service representative will guide you through the exchange process.</li>
          </ol>

          <h3>Important Notes</h3>
          <ul>
            <li>All damaged or incorrect items must be returned to Falcon Safe Marketing Sdn Bhd to qualify for a refund or exchange.</li>
            <li>Refunds will be issued via bank transfer only.</li>
            <li>
              Customers are responsible for providing accurate bank account details. Falcon Safe Marketing Sdn Bhd shall
              not be liable for delays arising from incorrect or incomplete banking information provided by the customer.
            </li>
            <li>Exchanges and refunds are only applicable within the first 7 days of receiving your item.</li>
          </ul>
        </div>
      </section>

      <section class="policy-panel" id="terms-panel" aria-labelledby="terms" data-policy-panel="terms" hidden>
        <p class="policy-eyebrow">Terms & Conditions</p>
        <h2>Terms of use</h2>
        <div class="policy-copy">
          <p>
            ornis.falconsafe.com.my does not collect personally identifiable information about its visitors, except
            when such visitors provide such information on a voluntary basis. This information is not shared nor sold to
            a 3rd party. The e-mail addresses on our database are used to send information updates about this site and
            you may choose to opt out.
          </p>
          <p>
            There are tracking and monitoring programs installed on this site that records each visitor's movement,
            usage, referrals, IP address, browser type, operating system and other non-personal information. This is for
            statistical purposes and for us to improve the products and offerings on ornis.falconsafe.com.my.
          </p>

          <h3>Terms of Use</h3>
          <p>
            By accessing ornis.falconsafe.com.my, directly or indirectly, you declare, agree and accept the following
            terms which may be updated at anytime without prior notice:
          </p>
          <p>
            The entire editorial, textual and graphical content of ornis.falconsafe.com.my is protected by international
            copyright laws. This includes the site's concept, color, themes, buttons, graphics, pictures, audio files,
            video files, logos, artwork, design, layout, html, text, source codes, javascripts, search results,
            listings, database, comments, descriptions and all other elements. Unauthorized copying or use of any
            material is a violation of applicable criminal and civil laws.
          </p>
          <p>
            The framing, mirroring, scraping or data-mining of this web site or any of its content in any form and by
            any method is strictly prohibited. You may however link or deep-link to any page without permission.
          </p>
          <p>
            The providers, owners and creators of ornis.falconsafe.com.my cannot be held responsible for any losses,
            whether direct or indirect, resulting from this website.
          </p>
          <p>
            The providers, owners and creators of ornis.falconsafe.com.my do not endorse, support, sponsor, represent,
            warrant or guarantee any product, service, opinion, comment, recommendation, description, suggestion,
            advice, consultation or information given, offered, hired, exchanged, traded, sold, advertised, announced or
            implied by any of the external sites, establishments, organization or entities listed on this site.
          </p>
          <p>
            All logos, brands, product names and files referenced on this website may be the trademarks of their
            respective owners/holders. ornis.falconsafe.com.my does not claim ownership on all the content on our
            website.
          </p>
          <p>
            By accessing any page in ornis.falconsafe.com.my, you will have released and discharged the providers,
            owners and creators from any and all liability which may arise.
          </p>
        </div>
      </section>

    </main>

    <script>
      const tabs = Array.from(document.querySelectorAll("[data-policy-tab]"));
      const panels = Array.from(document.querySelectorAll("[data-policy-panel]"));
      const validTabs = new Set(tabs.map((tab) => tab.getAttribute("data-policy-tab")));
      const policyTitles: Record<string, string> = {
        privacy: "Privacy Policy | Falcon Safe",
        returns: "Return & Refund Policy | Falcon Safe",
        terms: "Terms & Conditions | Falcon Safe",
      };

      const activatePolicyTab = (tabId: string) => {
        const nextTab = validTabs.has(tabId) ? tabId : "privacy";

        tabs.forEach((tab) => {
          const isActive = tab.getAttribute("data-policy-tab") === nextTab;
          tab.setAttribute("aria-selected", String(isActive));
        });

        panels.forEach((panel) => {
          const isActive = panel.getAttribute("data-policy-panel") === nextTab;
          panel.toggleAttribute("hidden", !isActive);
          panel.classList.toggle("is-active", isActive);
        });

        document.title = policyTitles[nextTab] || "Falcon Safe Policies";
      };

      const activateFromHash = () => activatePolicyTab(window.location.hash.replace("#", ""));

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          activatePolicyTab(tab.getAttribute("data-policy-tab") || "privacy");
        });
      });

      window.addEventListener("hashchange", activateFromHash);
      activateFromHash();
    </script>
  </body>
</html>

<style>
  :global(body.policies-page) {
    margin: 0;
    background: #f6f1ea;
    color: #1e1f20;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .policies-hero {
    display: grid;
    gap: 0.85rem;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 5vw, 5rem) clamp(3rem, 8vw, 6rem);
    background: #111;
    color: #fff;
    text-align: center;
  }

  .policies-logo {
    display: inline-flex;
    width: fit-content;
    margin: 0 auto clamp(0.5rem, 1.5vw, 1rem);
  }

  .policies-logo img {
    width: clamp(4.5rem, 8vw, 6.25rem);
    height: auto;
  }

  .policies-hero p,
  .policies-hero span {
    margin: 0;
    color: #b8b8b8;
    font-weight: 700;
  }

  .policies-hero p {
    color: #ffe330;
    font-size: clamp(0.82rem, 1vw, 0.95rem);
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policies-hero h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 5rem);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .policies-shell {
    width: min(calc(100% - clamp(1rem, 4vw, 3rem)), 1120px);
    margin: clamp(-2.2rem, -4vw, -1.2rem) auto clamp(2rem, 5vw, 4rem);
  }

  .policies-tabs {
    position: sticky;
    top: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(17, 17, 17, 0.12);
    background: #fff;
    box-shadow: 0 1rem 2.5rem rgba(17, 17, 17, 0.08);
  }

  .policies-tabs a {
    display: inline-flex;
    min-height: 4rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    border-bottom: 3px solid transparent;
    color: #555;
    font-weight: 900;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
  }

  .policies-tabs a[aria-selected="true"],
  .policies-tabs a:hover,
  .policies-tabs a:focus-visible {
    border-bottom-color: #ffe330;
    background: #111;
    color: #fff;
    outline: none;
  }

  .policy-panel {
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-top: 0;
    background: rgba(255, 255, 255, 0.9);
  }

  .policy-eyebrow {
    margin: 0 0 0.65rem;
    color: #955f69;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .policy-panel h2 {
    max-width: 48rem;
    margin: 0 0 clamp(1.3rem, 3vw, 2.25rem);
    color: #111;
    font-size: clamp(1.8rem, 4vw, 3.3rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .policy-copy {
    display: grid;
    gap: 1rem;
    color: #3f3b38;
    font-size: clamp(0.98rem, 1.35vw, 1.08rem);
    line-height: 1.7;
  }

  .policy-copy p,
  .policy-copy ul,
  .policy-copy ol {
    margin: 0;
  }

  .policy-copy h3 {
    margin: 1.15rem 0 -0.15rem;
    color: #111;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
  }

  .policy-copy ul,
  .policy-copy ol {
    padding-left: 1.25rem;
  }

  .policy-copy li + li {
    margin-top: 0.4rem;
  }

  .policy-copy a {
    color: #0e5963;
    font-weight: 800;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 720px) {
    .policies-tabs {
      grid-template-columns: 1fr;
      position: static;
    }

    .policies-tabs a {
      min-height: 3.35rem;
      border-bottom-width: 2px;
    }
  }
</style>
