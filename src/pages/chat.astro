---
import "../styles/globals.css";
import TrackingBody from "@/components/TrackingBody.astro";
import TrackingHead from "@/components/TrackingHead.astro";

const whatsappChatUrl = "https://sitetarik-chatbot-v2.easondev.workers.dev/wa/ornis";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Continue to WhatsApp to chat with the Falcon Safe team."
    />
    <meta name="robots" content="noindex, nofollow" />
    <TrackingHead />
    <script is:inline define:vars={{ whatsappChatUrl }}>
      (function () {
        const currentParams = new URLSearchParams(window.location.search);
        const attributionKeys = [
          "clid",
          "fbclid",
          "ttclid",
          "gclid",
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_content",
          "utm_term",
        ];

        const buildDestinationUrl = () => {
          try {
            const url = new URL(whatsappChatUrl);
            const attribution = window.ornisGetAttribution?.() || {};

            attributionKeys.forEach((key) => {
              const value = currentParams.get(key) || attribution[key];
              if (value && !url.searchParams.has(key)) {
                url.searchParams.set(key, value);
              }
            });

            return url.toString();
          } catch {
            return whatsappChatUrl;
          }
        };

        const destinationUrl = buildDestinationUrl();

        const getStoredValue = (area, key) => {
          try {
            return window[area]?.getItem(key) || "";
          } catch {
            return "";
          }
        };

        const sendServerTrackingEvent = (payload) => {
          const attribution = window.ornisGetAttribution?.() || {};
          const event = {
            event_id: crypto.randomUUID ? crypto.randomUUID() : `event_${Date.now()}_${Math.random().toString(16).slice(2)}`,
            event_time: new Date().toISOString(),
            event_name: "whatsapp_redirect",
            visitor_id: getStoredValue("localStorage", "ornis_tracking_visitor_id"),
            session_id: getStoredValue("sessionStorage", "ornis_tracking_session_id"),
            full_url: window.location.href,
            page_path: window.location.pathname,
            query: window.location.search,
            referrer: document.referrer || "",
            user_agent: navigator.userAgent,
            language: navigator.language || "",
            screen: `${window.screen?.width || 0}x${window.screen?.height || 0}`,
            timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || "",
            ...attribution,
            payload,
          };
          const text = JSON.stringify({ events: [event] });
          let sentWithBeacon = false;

          try {
            if (navigator.sendBeacon) {
              sentWithBeacon = navigator.sendBeacon("/api/track", new Blob([text], { type: "application/json" }));
            }
          } catch {}

          if (!sentWithBeacon) {
            fetch("/api/track", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: text,
              keepalive: true,
            }).catch(() => {});
          }
        };

        const trackBridge = () => {
          const payload = {
            contact_type: "whatsapp",
            content_name: "WhatsApp bridge page",
            destination: destinationUrl,
            action: "continue_to_whatsapp",
          };

          try {
            window.ornisTrackMetaCustomEvent?.("WhatsAppRedirect", payload);
            sendServerTrackingEvent(payload);
          } catch {}
        };

        const redirectToWhatsApp = () => {
          window.location.href = destinationUrl;
        };

        window.addEventListener("DOMContentLoaded", () => {
          const link = document.querySelector("[data-whatsapp-link]");
          if (!link) return;

          link.setAttribute("href", destinationUrl);
          link.addEventListener("click", (event) => {
            event.preventDefault();
            trackBridge();
            window.setTimeout(redirectToWhatsApp, 150);
          });
        });
      })();
    </script>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230f565d'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23f6f1ea'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23f6f1ea' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Continue to WhatsApp</title>
  </head>
  <body>
    <TrackingBody />
    <main class="whatsapp-bridge">
      <section class="whatsapp-bridge__panel" aria-labelledby="whatsapp-bridge-title">
        <img
          src="/ornis/falcon-safe-footer-logo.png"
          alt="Falcon Safe"
          class="whatsapp-bridge__logo"
          width="280"
          height="80"
          decoding="async"
        />
        <h1 id="whatsapp-bridge-title">Redirecting you to WhatsApp</h1>
        <span>Tap the button below to continue.</span>
        <a data-whatsapp-link href={whatsappChatUrl} rel="noopener noreferrer">Continue to WhatsApp</a>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: #f6f1ea;
    color: #1f2020;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .whatsapp-bridge {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .whatsapp-bridge__panel {
    display: grid;
    width: min(100%, 34rem);
    justify-items: center;
    gap: 1rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid rgba(14, 89, 99, 0.13);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 1.25rem 3rem rgba(52, 40, 31, 0.12);
    text-align: center;
  }

  .whatsapp-bridge__logo {
    width: min(100%, 12rem);
    height: auto;
    object-fit: contain;
  }

  .whatsapp-bridge__panel p {
    margin: 0;
    color: #955f69;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .whatsapp-bridge__panel h1 {
    margin: 0;
    color: #0e5963;
    font-size: clamp(2rem, 7vw, 3.75rem);
    line-height: 1;
  }

  .whatsapp-bridge__panel span {
    max-width: 26rem;
    color: #665d57;
    line-height: 1.6;
  }

  .whatsapp-bridge__panel a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.25rem;
    padding: 0 1.25rem;
    border-radius: 8px;
    background: #25d366;
    color: #0f2b1a;
    font-weight: 900;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .whatsapp-bridge__panel a:hover {
    transform: translateY(-1px);
    box-shadow: 0 0.75rem 1.5rem rgba(37, 211, 102, 0.2);
  }

  .whatsapp-bridge__panel a:focus-visible {
    outline: 3px solid rgba(37, 211, 102, 0.35);
    outline-offset: 3px;
  }
</style>
