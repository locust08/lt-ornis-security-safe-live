      { label: "Ornis", href: "#" },
      { label: "Fire-Resistant Safe", href: "#" },
      { label: "OR Emerald 530", href: "#" },
    ],
    description:
      "Larger fire-resistant security safe with smart lock access, biometric protection, and extra storage for documents and high-value items.",
    totalReview: 171,
    rating: 4.9,
    hasDiscount: true,
    originalPrice: 3160,
    price: 1800,
    dealerPrice: 1710,
