const featureCards: { title: string; description: string }[] = [];

const everydayLifeTiles = [
  {
    src: "/ornis/everyday-life-under-desk-ruby-310.png",
    alt: "OR Ruby 310 safe placed under a home office desk.",
    label: "Under desk",
    model: "OR Ruby 310",
  },
  {
    src: "/ornis/everyday-life-cabinet-emerald-310.png",
    alt: "OR Emerald 310 safe placed inside a warm wooden cabinet.",
