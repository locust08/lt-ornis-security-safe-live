---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ornis premium fire-resistant security safe overview."
    />
    <TrackingHead />
    <script is:inline define:vars={{ productContentEvent }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "view_item",
        ecommerce: productContentEvent,
      });
      window.ornisTrackMetaEvent?.("ViewContent", productContentEvent);
      window.posthog?.capture('product_viewed', {
        currency: productContentEvent.currency,
        value: productContentEvent.value,
        content_ids: productContentEvent.content_ids,
        num_items: productContentEvent.contents?.length,
      });
    </script>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230f565d'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23f6f1ea'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23f6f1ea' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Ornis Security Safe</title>
  </head>
  <body>
    <TrackingBody />
    <div class="promo-popup" data-promo-popup aria-hidden="true">
      <div class="promo-popup__backdrop" data-promo-close></div>
      <section class="promo-popup__dialog" role="dialog" aria-modal="true" aria-label="Limited time Ornis offer">
        <img
          src="/ornis/promo.png"
          alt="Limited time Ornis offer with up to 45 percent off, code ORNIS45, valid for 3 days only."
          width="1448"
          height="1086"
          loading="eager"
          decoding="async"
          data-promo-close
        />
      </section>
    </div>

    <main class="image-stack" aria-label="Ornis security safe product story">
      {
        images.map((image, index) => (
          <>
            {
              image.src === "/ornis/everyday-life-buy-now.png" ? (
                <section
                  id="everyday-life-section"
                  class="panel"
                  aria-label="Ornis safes in everyday home spaces"
                  data-track-section
                  data-section-id="everyday-life"
                  data-section-name="Fits Beautifully Into Everyday Life"
                >
                  <div class="everyday-life">
                    <div class="everyday-life__header">
                      <div>
                        <h2>Fits Beautifully Into Everyday Life</h2>
                        <p>Thoughtfully designed to protect what matters most-wherever life takes you.</p>
                      </div>
                    </div>

                    <div class="everyday-life__grid">
                      {everydayLifeTiles.map((tile) => (
                        <article class="everyday-life__tile">
                          <img
                            src={tile.src}
                            alt={tile.alt}
                            width="1792"
                            height="1024"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="everyday-life__badge">
                            <span>{tile.label}</span>
                            <strong>{tile.model}</strong>
                          </div>
                        </article>
                      ))}
                    </div>

                    <a class="everyday-life__button" href="#price-section">Buy Now</a>
                  </div>
                </section>
              ) : (
                <section class={`panel${index === 0 ? " panel--hero" : ""}`} aria-label={`Ornis product image ${index + 1}`}>
                  {index === 0 && (
                    <a class="hero-brand-logo" href="/" aria-label="Falcon Safe home">
                      <img
                        src="/ornis/falcon-safe-footer-logo.png"
                        alt="Falcon Safe - The World's Trusted Safe"
                        width="225"
                        height="225"
                        loading="eager"
                        decoding="async"
                      />
                    </a>
                  )}
                  {image.hasBuyNow ? (
                    <a class="panel__image-link" href="#price-section" aria-label="View Ornis prices">
                      <picture>
                        {image.mobileSrc && <source media="(max-width: 720px)" srcset={image.mobileSrc} />}
                        <img
                          src={image.src}
                          alt={image.alt}
                          width={image.width ?? 1672}
                          height={image.height ?? 941}
                          loading={index === 0 ? "eager" : "lazy"}
                          decoding="async"
                        />
                      </picture>
                    </a>
                  ) : (
                    <picture>
                      {image.mobileSrc && <source media="(max-width: 720px)" srcset={image.mobileSrc} />}
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width ?? 1672}
                        height={image.height ?? 941}
                        loading={index === 0 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    </picture>
                  )}
                </section>
              )
            }

            {
              index === 0 && (
                <>
                  <section class="countdown-offer" aria-label="Promotion countdown">
                    <div class="countdown-offer__main">
                      <p>Promotion ends in</p>
                      <div class="countdown-offer__timer" data-countdown>
                        <span>
                          <strong data-countdown-days>03</strong>
                          Days
                        </span>
                        <span>
                          <strong data-countdown-hours>00</strong>
                          Hours
                        </span>
                        <span>
                          <strong data-countdown-minutes>00</strong>
                          Minutes
                        </span>
                        <span>
                          <strong data-countdown-seconds>00</strong>
                          Seconds
                        </span>
                      </div>
                    </div>
                    <p class="countdown-offer__code">Use code <strong>ORNIS45</strong></p>
                  </section>

                  <section class="delivery-banner" aria-label="Free delivery promotion">
                    <div class="delivery-banner__track" aria-hidden="true">
                      <span>Free Delivery</span>
                      <span>Warranty 12 Months + 12 Months</span>
                      <span>Fast, Secure Shipping</span>
                      <span>Free Delivery</span>
                      <span>Doorstep Delivery Included</span>
                      <span>Free Delivery</span>
                      <span>Warranty 12 Months + 12 Months</span>
                      <span>Fast, Secure Shipping</span>
                      <span>Free Delivery</span>
                      <span>Doorstep Delivery Included</span>
                    </div>
                    <p class="sr-only">
                      Free delivery. Warranty 12 months plus 12 months. Fast, secure shipping. Doorstep delivery
                      included.
                    </p>
                  </section>
                </>
              )
            }
          </>
        ))
      }

      <div
        id="price-section"
        class="price-section"
        data-track-section
        data-section-id="price-section"
        data-section-name="Price Section"
      >
        <ProductOverview productItems={overviewData} sizesChart={sizes} colorsChart={colors} client:load />
      </div>

      <section class="google-reviews" aria-labelledby="google-reviews-title">
        <div class="google-reviews__inner">
          <div class="google-reviews__header">
            <div>
              <p class="google-reviews__eyebrow">Google Reviews</p>
              <h2 id="google-reviews-title">Our Safe &amp; Protected Customers</h2>
            </div>
            <div class="google-reviews__summary" aria-label="4.9 from 30 Google reviews">
              <span class="google-reviews__summary-stars" aria-hidden="true">★★★★★</span>
              <span><strong>4.9</strong> from 30 Google reviews</span>
            </div>
          </div>

          <div class="google-reviews__grid">
            {googleReviews.map((review) => (
              <article class="google-review-card">
                <div class="google-review-card__person">
                  <div class="google-review-card__avatar">
                    <img
                      src={review.avatarSrc}
                      alt={`${review.name} profile photo`}
                      width="128"
                      height="128"
                      loading="eager"
                      decoding="async"
                    />
                  </div>
                  <div>
                    <p class="google-review-card__name">{review.name}</p>
                    <div class="google-review-card__stars" aria-label={`${review.rating} out of 5 stars`}>
                      {Array.from({ length: 5 }, (_, starIndex) => (
                        <span aria-hidden="true">{starIndex < review.rating ? "★" : "☆"}</span>
                      ))}
                    </div>
                  </div>
                </div>

                {review.comment && <p class="google-review-card__comment">{review.comment}</p>}

                <p class="google-review-card__source">
                  <strong>Google</strong> review
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="panel" aria-label="Ornis confidence answered FAQ">
        <picture>
          <source media="(max-width: 720px)" srcset="/ornis/mobile/confidence-answered.png" />
          <img
            src="/ornis/confidence-answered-no-buy-now.png?v=20260528-40"
            alt="Ornis FAQ section answering questions about fireproof certification, up to 40 registered fingerprints, 8 AA battery use, dual authentication, keypad visibility, and key product benefits."
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </section>

      <AboutUs statCards={statCards} featureCards={featureCards} client:load />

      <footer class="site-footer" aria-label="Falcon Safe footer">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <a class="site-footer__logo-card" href="/" aria-label="Falcon Safe home">
              <img
                src="/ornis/falcon-safe-footer-logo.png"
                alt="Falcon Safe - The World's Trusted Safe"
                width="225"
                height="225"
                loading="lazy"
                decoding="async"
              />
            </a>
            <p>
              Fire-resistant security solutions for safer homes, offices, and
              everyday valuables.
            </p>
          </div>

          <nav class="site-footer__links" aria-label="Footer links">
            <h2>Quicklinks</h2>
            <a href="/policies#privacy">Privacy Policy</a>
            <a href="/policies#terms">Terms and Conditions</a>
            <a href="/policies#returns">Return & Refund Policy</a>
          </nav>

          <address class="site-footer__address">
            <h2>Contact Us</h2>
            <p>
              5 ½ Miles, G Floor, Lot 4912, Jalan Teratai, Off, Jalan Meru,
              41050 Klang, Selangor
            </p>
            <p>
              <a href="tel:+60333963888">+603-3396 3888</a>
            </p>
            <p>
              <a href="mailto:falcon@falconsafe.com">falcon@falconsafe.com</a>
            </p>
          </address>
        </div>
      </footer>

      <p class="site-copyright">Copyright © 2026 Falcon Safe Marketing Sdn Bhd</p>
    </main>

    <script is:inline define:vars={{ fallbackAddToCartEvent }}>
      const promoPopup = document.querySelector("[data-promo-popup]");
      const promoCloseButtons = document.querySelectorAll("[data-promo-close]");
      const fallbackAddToCartKey = "ornis_fallback_add_to_cart";

      document.addEventListener("click", (event) => {
        const button = event.target instanceof Element ? event.target.closest("button") : null;
        const unhydratedProductIsland = button?.closest("#price-section astro-island[ssr]");

        if (!button || !unhydratedProductIsland || !button.textContent?.includes("Add to Cart")) return;
        if (window.sessionStorage.getItem(fallbackAddToCartKey)) return;

        window.sessionStorage.setItem(fallbackAddToCartKey, "1");
        window.ornisTrackMetaEvent?.("AddToCart", {
          content_ids: fallbackAddToCartEvent.content_ids,
          contents: fallbackAddToCartEvent.contents,
          content_type: fallbackAddToCartEvent.content_type,
          currency: fallbackAddToCartEvent.currency,
          value: fallbackAddToCartEvent.value,
          num_items: fallbackAddToCartEvent.num_items,
        });
        window.ornisTrack?.("add_to_cart", fallbackAddToCartEvent);
        window.posthog?.capture('add_to_cart', {
          currency: fallbackAddToCartEvent.currency,
          value: fallbackAddToCartEvent.value,
          item_id: fallbackAddToCartEvent.content_ids?.[0],
          num_items: fallbackAddToCartEvent.num_items,
        });
      });

      if (promoPopup) {
        let promoTimer;
        const promoViewTrackingKey = `ornis_promo_view_${window.location.pathname}`;

        const openPromoPopup = () => {
          promoPopup.setAttribute("aria-hidden", "false");
          document.documentElement.classList.add("promo-popup-is-open");
          if (!window.sessionStorage.getItem(promoViewTrackingKey)) {
            window.sessionStorage.setItem(promoViewTrackingKey, "1");
            window.ornisTrackMetaCustomEvent?.("PromoView", {
              content_name: "ORNIS45 promo popup",
              content_category: "Promotion",
            });
            window.ornisTrack?.("promo_view", {
              content_name: "ORNIS45 promo popup",
              content_category: "Promotion",
            });
            window.posthog?.capture('promo_popup_viewed', {
              promo_code: 'ORNIS45',
              page_path: window.location.pathname,
            });
          }
        };

        const closePromoPopup = () => {
          const wasOpen = promoPopup.getAttribute("aria-hidden") === "false";
          promoPopup.setAttribute("aria-hidden", "true");
          document.documentElement.classList.remove("promo-popup-is-open");
          if (wasOpen) {
            window.ornisTrackMetaCustomEvent?.("PromoDismiss", {
              content_name: "ORNIS45 promo popup",
              page_path: window.location.pathname,
            });
            window.ornisTrack?.("promo_dismiss", {
              content_name: "ORNIS45 promo popup",
              page_path: window.location.pathname,
            });
          }
        };

        const schedulePromoPopup = () => {
          window.clearTimeout(promoTimer);
          closePromoPopup();
          promoTimer = window.setTimeout(openPromoPopup, 4000);
        };

        schedulePromoPopup();
        window.addEventListener("pageshow", schedulePromoPopup);

        promoCloseButtons.forEach((button) => {
          button.addEventListener("click", () => {
            window.clearTimeout(promoTimer);
            closePromoPopup();
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closePromoPopup();
        });
      }

      const countdownRoot = document.querySelector("[data-countdown]");
      const countdownDays = document.querySelector("[data-countdown-days]");
      const countdownHours = document.querySelector("[data-countdown-hours]");
      const countdownMinutes = document.querySelector("[data-countdown-minutes]");
      const countdownSeconds = document.querySelector("[data-countdown-seconds]");
      const countdownStorageKey = "ornis-offer-countdown-end-3-days";
      const countdownLength = 3 * 24 * 60 * 60 * 1000;

      if (countdownRoot && countdownDays && countdownHours && countdownMinutes && countdownSeconds) {
        const storedEnd = Number(localStorage.getItem(countdownStorageKey));
        let countdownEnd = Number.isFinite(storedEnd) && storedEnd > Date.now()
          ? storedEnd
          : Date.now() + countdownLength;

        localStorage.setItem(countdownStorageKey, String(countdownEnd));

        const pad = (value) => String(value).padStart(2, "0");

        const updateCountdown = () => {
          let remaining = countdownEnd - Date.now();

          if (remaining <= 0) {
            countdownEnd = Date.now() + countdownLength;
            localStorage.setItem(countdownStorageKey, String(countdownEnd));
            remaining = countdownLength;
          }

          const totalSeconds = Math.ceil(remaining / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hours = Math.floor((totalSeconds % 86400) / 3600);
          const minutes = Math.floor((totalSeconds % 3600) / 60);
          const seconds = totalSeconds % 60;

          countdownDays.textContent = pad(days);
          countdownHours.textContent = pad(hours);
          countdownMinutes.textContent = pad(minutes);
          countdownSeconds.textContent = pad(seconds);
        };

        updateCountdown();
        window.setInterval(updateCountdown, 1000);
      }

      document.querySelectorAll('a[href="#price-section"]').forEach((link) => {
        link.addEventListener("click", () => {
          window.ornisTrackMetaCustomEvent?.("CTA_Click", {
            content_name: link.getAttribute("aria-label") || link.textContent?.trim() || "Buy Now",
            destination: "#price-section",
            page_path: window.location.pathname,
          });
          window.ornisTrack?.("cta_click", {
            content_name: link.getAttribute("aria-label") || link.textContent?.trim() || "Buy Now",
            destination: "#price-section",
            page_path: window.location.pathname,
          });
          window.posthog?.capture('cta_clicked', {
            cta_label: link.getAttribute("aria-label") || link.textContent?.trim() || "Buy Now",
            destination: "#price-section",
            page_path: window.location.pathname,
          });
        });
      });

      const sectionViewThreshold = 0.5;
      const trackSectionView = (section) => {
        const sectionId = section.getAttribute("data-section-id") || section.id || "section";
        const sectionName = section.getAttribute("data-section-name") || sectionId;
        const storageKey = `ornis_section_view_${window.location.pathname}_${sectionId}`;

        if (window.sessionStorage.getItem(storageKey)) return;

        window.sessionStorage.setItem(storageKey, "1");
        const payload = {
          content_name: sectionName,
          section_id: sectionId,
          page_path: window.location.pathname,
        };

        window.ornisTrackMetaCustomEvent?.("SectionView", payload);
        window.ornisTrack?.("section_view", payload);
      };

      const trackedSections = Array.from(document.querySelectorAll("[data-track-section]"));

      if ("IntersectionObserver" in window) {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio >= sectionViewThreshold) {
                trackSectionView(entry.target);
                sectionObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: [sectionViewThreshold] },
        );

        trackedSections.forEach((section) => sectionObserver.observe(section));
      } else {
        const checkTrackedSections = () => {
          trackedSections.forEach((section) => {
            const rect = section.getBoundingClientRect();
            const visibleHeight = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
            const visibleRatio = rect.height ? visibleHeight / rect.height : 0;

            if (visibleRatio >= sectionViewThreshold) {
              trackSectionView(section);
            }
          });
        };

        checkTrackedSections();
        window.addEventListener("scroll", checkTrackedSections, { passive: true });
        window.addEventListener("resize", checkTrackedSections);
      }

      document.querySelectorAll(".site-footer__links a").forEach((link) => {
        link.addEventListener("click", () => {
          window.ornisTrackMetaCustomEvent?.("FooterLinkClick", {
            content_name: link.textContent?.trim() || "Footer link",
            destination: link.getAttribute("href") || "",
            page_path: window.location.pathname,
          });
          window.ornisTrack?.("footer_link_click", {
            content_name: link.textContent?.trim() || "Footer link",
            destination: link.getAttribute("href") || "",
            page_path: window.location.pathname,
          });
        });
      });

      document.querySelectorAll('a[href^="tel:"], a[href^="mailto:"]').forEach((link) => {
        link.addEventListener("click", () => {
          window.ornisTrackMetaCustomEvent?.("Contact", {
            contact_type: link.getAttribute("href")?.startsWith("tel:") ? "phone" : "email",
            destination: link.getAttribute("href") || "",
            page_path: window.location.pathname,
          });
          window.ornisTrack?.("contact_click", {
            contact_type: link.getAttribute("href")?.startsWith("tel:") ? "phone" : "email",
            destination: link.getAttribute("href") || "",
            page_path: window.location.pathname,
          });
        });
      });
    </script>
