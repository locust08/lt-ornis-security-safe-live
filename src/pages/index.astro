const productContentEvent = {
  content_name: "Ornis Fire-Resistant Security Safe",
  content_type: "product",
  content_ids: overviewData.map((product) => product.id),
  contents: overviewData.map((product) => ({
    id: product.id,
    quantity: 1,
    item_price: product.price,
  })),
  value: Math.min(...overviewData.map((product) => product.price)),
  currency: "MYR",
};

const fallbackAddToCartEvent = {
  content_ids: [overviewData[0].id],
  contents: [
    {
      id: overviewData[0].id,
      quantity: 1,
      item_price: overviewData[0].originalPrice,
    },
  ],
  content_type: "product",
  currency: "MYR",
  value: overviewData[0].originalPrice,
  num_items: 1,
  items: [
    {
      item_id: overviewData[0].id,
      item_name: overviewData[0].name,
      item_variant: [overviewData[0].defaultSize, overviewData[0].defaultColorOption].filter(Boolean).join(" / "),
      price: overviewData[0].originalPrice,
      quantity: 1,
    },
  ],
  coupon: "",
};

const sizes = [
  { value: "310", label: "OR 310" },
  { value: "530", label: "OR 530" },
];

const colors = [
  {
    value: "ruby",
    label: "Ruby",
    colorOption:
      "bg-[#b89aa3] has-data-[state=checked]:outline has-data-[state=checked]:outline-2 has-data-[state=checked]:outline-offset-2 has-data-[state=checked]:outline-[#955f69]",
  },
