---
import "../styles/globals.css";
import TrackingBody from "@/components/TrackingBody.astro";
import TrackingHead from "@/components/TrackingHead.astro";
import { getUnitPrice } from "@/lib/ornis/catalog";
import { getRuntimeEnv } from "@/lib/ornis/env";
import { findOrderRow } from "@/lib/ornis/google";
import { sheetRowToOrder } from "@/lib/ornis/order";

export const prerender = false;

const orderId = Astro.url.searchParams.get("order") ?? "";
const status = Astro.url.searchParams.get("status") ?? "Pending";
const paid = status.toLowerCase() === "paid";
const env = getRuntimeEnv(Astro);
const metaPixelId = env.META_PIXEL_ID?.trim() || env.PUBLIC_META_PIXEL_ID?.trim() || "1848746201969006";
const gtmContainerId = (env.GTM_CONTAINER_ID ?? env.PUBLIC_GTM_CONTAINER_ID ?? "").trim();
const ga4MeasurementId = (env.GA4_MEASUREMENT_ID ?? env.PUBLIC_GA4_MEASUREMENT_ID ?? env.GOOGLE_ANALYTICS_ID ?? "").trim();
const trackingConfigured = Boolean(metaPixelId || gtmContainerId || ga4MeasurementId);
let purchaseEvent:
  | {
      orderId: string;
      value: number;
      currency: string;
      contentIds: string[];
      contents: { id: string; quantity: number }[];
      items: { item_id: string; item_name: string; item_variant: string; price: number; quantity: number }[];
      numItems: number;
    }
  | null = null;

if (paid && orderId && trackingConfigured) {
  try {
    const existing = await findOrderRow(env, orderId);
    const order = existing ? sheetRowToOrder(existing.values) : null;
    const oldStatusValue = String(existing?.values[2] ?? "");
    const hasCreatedTimeColumn = !["paid", "pending", "failed"].includes(oldStatusValue.toLowerCase());
    const orderPaid = String(existing?.values[hasCreatedTimeColumn ? 3 : 2] ?? "").toLowerCase() === "paid";

    if (order && orderPaid) {
      purchaseEvent = {
        orderId: order.orderId,
        value: order.totalPaid,
        currency: "MYR",
        contentIds: order.items.map((item) => item.id),
        contents: order.items.map((item) => ({ id: item.id, quantity: item.quantity })),
        items: order.items.map((item) => ({
          item_id: item.id,
          item_name: `${item.model} ${item.color}`,
          item_variant: item.color,
          price: getUnitPrice(item, order.promoCode),
          quantity: item.quantity,
        })),
        numItems: order.items.reduce((sum, item) => sum + item.quantity, 0),
      };
    }
  } catch (error) {
    console.error("Unable to prepare purchase tracking event.", error);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ornis payment confirmation." />
    <TrackingHead />
    {
      purchaseEvent && (
        <script is:inline define:vars={{ purchaseEvent }}>
          const storageKey = `tracking_purchase_${purchaseEvent.orderId}`;
          const alreadyTracked = window.sessionStorage.getItem(storageKey);

          if (!alreadyTracked) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: "purchase",
              event_id: purchaseEvent.orderId,
              ecommerce: {
                transaction_id: purchaseEvent.orderId,
                value: purchaseEvent.value,
                currency: purchaseEvent.currency,
                items: purchaseEvent.items,
              },
            });

            if (window.gtag) {
              gtag("event", "purchase", {
                transaction_id: purchaseEvent.orderId,
                value: purchaseEvent.value,
                currency: purchaseEvent.currency,
                items: purchaseEvent.items,
              });
            }

            if (window.fbq) {
              window.fbq(
                "track",
                "Purchase",
                {
                  value: purchaseEvent.value,
                  currency: purchaseEvent.currency,
                  content_ids: purchaseEvent.contentIds,
                  contents: purchaseEvent.contents,
                  content_type: "product",
                  num_items: purchaseEvent.numItems,
                },
                { eventID: purchaseEvent.orderId },
              );
            }

            window.ornisTrack?.("purchase", purchaseEvent);
            window.sessionStorage.setItem(storageKey, "1");
          }
        </script>
      )
    }
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230f565d'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23f6f1ea'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23f6f1ea' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Thank You | Ornis</title>
  </head>
  <body>
    <TrackingBody />
    <main class="thank-you">
      <section class="thank-you__panel">
        <p>{paid ? "Payment successful" : "Payment received for review"}</p>
        <h1>{paid ? "Thank You For Your Order" : "Thank You"}</h1>
        <div class="thank-you__lock" aria-hidden="true">
          <img src="/ornis/or-emerald-530-hd.png" alt="" width="520" height="390" />
        </div>
        {orderId && <strong>Order ID: {orderId}</strong>}
        <span>
          {paid
            ? "We have received your payment. Our team will contact you about delivery."
            : "Your payment status is being confirmed. Our team will contact you once it is updated."}
        </span>
        <a href="/">Back to Ornis</a>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 255, 255, 0.72), transparent 30rem),
      #f6f1ea;
    color: #1f2020;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .thank-you {
    display: grid;
    min-height: 100vh;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }

  .thank-you__panel {
    display: grid;
    width: min(100%, 42rem);
    justify-items: center;
    gap: 1rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid rgba(14, 89, 99, 0.13);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 1.25rem 3rem rgba(52, 40, 31, 0.12);
    text-align: center;
  }

  .thank-you__panel p {
    margin: 0;
    color: #955f69;
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .thank-you__panel h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.25rem);
    line-height: 1;
  }

  .thank-you__lock {
    width: min(100%, 18rem);
    border-radius: 8px;
    background: #f1ece6;
  }

  .thank-you__lock img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .thank-you__panel strong,
  .thank-you__panel span {
    color: #665d57;
    line-height: 1.6;
  }

  .thank-you__panel a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0 1.25rem;
    border-radius: 8px;
    background: #0e5963;
    color: #fff;
    font-weight: 900;
    text-decoration: none;
  }
</style>
