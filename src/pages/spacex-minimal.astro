---
const hero = {
  src: "/ornis/ornis-spacex-minimal-hero-4k.webp",
  alt: "Minimal dark aerospace Ornis security safe hero with logo, fire-resistant security headline, sub-heading, Buy Now button, and original white and rose product safe.",
  width: 3840,
  height: 2160,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ornis security safe minimal dark aerospace hero concept."
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23030408'/%3E%3Cpath d='M20 25h24v20H20z' fill='%23f5f2ee'/%3E%3Cpath d='M24 25v-5a8 8 0 0 1 16 0v5' fill='none' stroke='%23f5f2ee' stroke-width='5'/%3E%3C/svg%3E"
    />
    <title>Ornis SpaceX Minimal Hero</title>
  </head>
  <body>
    <main class="hero-page" aria-label="Ornis SpaceX minimal hero concept">
      <img
        src={hero.src}
        alt={hero.alt}
        width={hero.width}
        height={hero.height}
        loading="eager"
        decoding="async"
      />
    </main>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    background: #030408;
    color: #f7f7f4;
  }

  body {
    margin: 0;
    min-width: 320px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #030408;
  }

  .hero-page {
    min-height: 100vh;
    display: grid;
    place-items: start center;
    padding: clamp(0.5rem, 2vw, 1.25rem);
    background:
      radial-gradient(circle at 78% 0%, rgba(91, 151, 210, 0.16), transparent 30rem),
      #030408;
  }

  .hero-page img {
    display: block;
    width: min(100%, 1672px);
    height: auto;
    border-radius: clamp(0.35rem, 0.8vw, 0.75rem);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.48);
  }
</style>
